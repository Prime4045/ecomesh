# EcoMesh Environment Configuration Template
# Copy this file to .env and fill in your keys:

# World Air Quality Index (WAQI) Token
# Obtain a free token at https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=your_waqi_api_token_here

# Google Gemini 2.5 Flash API Key (For Live Executive Reasoning Synthesis)
# Obtain a key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
